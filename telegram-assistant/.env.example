# ===== Telegram =====
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# polling — просто запустить и работать; webhook — для VPS с доменом и HTTPS
BOT_MODE=polling
WEBHOOK_BASE_URL=https://your-domain.example
WEBHOOK_SECRET=replace-with-long-random-string

# ===== PostgreSQL =====
# Значения ниже совпадают с docker-compose (сервис db).
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant
DATABASE_URL=postgresql+asyncpg://assistant:assistant@db:5432/assistant

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== LLM (разбор смысла) — OpenAI-совместимый или Anthropic =====
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Пример для OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=google/gemini-flash-1.5
# Пример для Anthropic:
#   LLM_PROVIDER=anthropic
#   LLM_BASE_URL=https://api.anthropic.com
#   LLM_MODEL=claude-3-5-haiku-latest

# ===== Эмбеддинги (семантическая память) =====
EMBEDDINGS_API_KEY=sk-...
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536

# ===== Speech-to-text (голосовые) =====
STT_PROVIDER=openai
STT_API_KEY=sk-...
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# ===== Прочее =====
DEFAULT_TIMEZONE=Europe/Moscow
SCHEDULER_TICK_SECONDS=30
APP_PORT=8080
